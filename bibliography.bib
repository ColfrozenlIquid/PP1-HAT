@online{veytsmanRewriteItRust2024,
  title = {Rewrite It in {{Rust}}: {{A Computational Physics Case Study}}},
  shorttitle = {Rewrite It in {{Rust}}},
  author = {Veytsman, Willow and Zhai, Shuang and Ding, Chen and Sefkow, Adam B.},
  date = {2024-10-24},
  eprint = {2410.19146},
  eprinttype = {arXiv},
  eprintclass = {physics},
  doi = {10.48550/arXiv.2410.19146},
  url = {http://arxiv.org/abs/2410.19146},
  urldate = {2025-02-28},
  abstract = {Surveys of computational science show that many scientists use languages like C and C++ in order to write code for scientific computing, especially in scenarios where performance is a key factor. In this paper, we seek to evaluate the use of Rust in such a scenario, through implementations of a physics simulation in both C++ and Rust. We also create a parallel version of our Rust code, in order to further explore performance as well as parallel code complexity. Measuring performance as program runtime, we find that Rust can offer better performance than C++, with some test cases showing as much as a 5.6\texttimes{} performance increase, and that parallel code in Rust can further improve performance while being easy to write safely. Finally, we provide some preliminary profiling to better understand the difference between the way our implementations perform.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {Physics - Computational Physics},
  file = {C:\Users\Daniel\Zotero\storage\B8MHE8D7\Veytsman et al. - 2024 - Rewrite it in Rust A Computational Physics Case Study.pdf}
}
