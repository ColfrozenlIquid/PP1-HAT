  title = {A Systematic Review of Electricity Demand for Large Language Models: Evaluations, Challenges, and Solutions},
  shorttitle = {A Systematic Review of Electricity Demand for Large Language Models},
  author = {Ji, Zhenya and Jiang, Ming},
  date = {2026-01},
  journaltitle = {Renewable and Sustainable Energy Reviews},
  shortjournal = {Renewable and Sustainable Energy Reviews},
  volume = {225},
