@online{kasneciEuropesAIImperative2025,
  title = {Europe’s {{AI Imperative}} - {{A Pragmatic Blueprint}} for {{Global Tech Leadership}}},
  author = {Kasneci, Gjergji and Gasser, Urs and Hofmann, Thomas F. and Kramer, Gerhard and Müller, Gerhard and Peus, Claudia and Schönenberger, Helmut and Kasneci, Enkelejda},
